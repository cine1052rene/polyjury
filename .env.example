# Copy to .env and fill in your own keys (never commit .env)

# Required: Nebius Token Factory key (jurors, Nemotron)
NEBIUS_API_KEY=
# Required for proofs in Nebius Sandboxes. The ID starts with "ai": aiproject-...
# (a plain project-... ID answers 403). Without it, proofs need --allow-local-exec.
NEBIUS_PROJECT_ID=aiproject-...

# Optional: Tavily, for the Sources drawer and the upstream check on the web
TAVILY_API_KEY=
# Optional: raises GitHub's search limit for the upstream check (no scopes needed)
GITHUB_TOKEN=
# Optional: signs proofs and encrypts cookies; defaults to a value derived from NEBIUS_API_KEY
POLYJURY_SECRET=

# Optional: "Sign in with GitHub" (an OAuth app with no scopes)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
